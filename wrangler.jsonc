{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daifugo-online",
  "main": "src/index.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "DaifugoRoom" }
    ]
  },
  // v2 で足した身内ルームの台帳は v3 で削除した。
  // クラスを消すだけではデプロイが通らないので、deleted_classes の行を消さないこと
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DaifugoRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["PrivateRegistry"] },
    { "tag": "v3", "deleted_classes": ["PrivateRegistry"] }
  ],
  "observability": {
    "enabled": true
  }
}

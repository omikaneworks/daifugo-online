{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daifugo-online",
  "main": "src/index.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "DaifugoRoom" },
      // 身内ルームの合言葉台帳。インスタンスは1つだけ使う
      { "name": "PRIVATE", "class_name": "PrivateRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DaifugoRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["PrivateRegistry"] }
  ],
  "observability": {
    "enabled": true
  }
}
